# 05-Install.tools for the 'dev-core' profile

# Homebrew formulae
# git is installed in the default tier (bootstrap.sh needs it), but
# dev-core re-asserts it as a development tool alongside gh. Install is
# additive and idempotent, so the re-assertion is a no-op on machines
# that already have git from the default tier.
brew 'git'
brew 'gh'
brew 'markdownlint-cli2'
brew 'rsync'

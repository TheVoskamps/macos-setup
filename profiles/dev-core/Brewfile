# Brewfile for the 'dev-core' profile — basic development tooling.

# Homebrew formulae
# git is installed in the core tier (bootstrap.sh needs it), but dev-core
# re-asserts it as a development tool alongside gh. Install is additive and
# idempotent, so the re-assertion is a no-op on machines that already have
# git from the core tier.
brew 'git'
brew 'gh'
brew 'markdownlint-cli2'
brew 'rsync'
# mkcert issues locally-trusted development certificates. It moved here from
# the core tier's old security slot: it is development tooling, not a
# security app every machine wants.
brew 'mkcert'

# Casks
cask 'drawio'
cask 'figma'
cask 'postman'

# Mac App Store (mas)
mas 'Xcode (16.4)', id: 497799835
